{
  "name": "hesabdar-sazeh-desktop",
  "version": "1.0.0",
  "description": "سامانه حسابداری سازه و پروژه‌های ساختمانی (نسخه دسکتاپ آفلاین ویندوز)",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sazeh.accounting",
    "productName": "HesabdarSazeh",
    "directories": {
      "output": "dist-exe"
    },
    "files": [
      "dist/**/*",
      "server.ts",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "سامانه حسابداری سازه"
    }
  }
}
